# 文本规范化：仓库内统一为 LF；检出时可被 .editorconfig 提示覆盖
* text=auto

# Windows 生态文件保持 CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sln text eol=crlf

# 钩子脚本必须是 LF，否则在 sh 下可能无法执行
.githooks/* text eol=lf

# 二进制：不做换行转换、不生成文本 diff
*.jar binary
*.jks binary
*.keystore binary
*.p12 binary
*.dll binary
*.exe binary
*.apk binary
*.zip binary
*.png binary
*.ico binary
