root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json,gradle}]
indent_size = 2

# Windows PowerShell 5.1 对「无 BOM 的 UTF-8 脚本」会按 GBK 解码，
# 导致中文字符串里的引号被吞、脚本语法报错（本项目踩过这个坑）。
# 因此 .ps1 必须带 UTF-8 BOM，且保持 CRLF。
[*.ps1]
charset = utf-8-bom
end_of_line = crlf

[*.{bat,cmd,sln}]
end_of_line = crlf

[*.{cs,kt,java,kts}]
indent_size = 4

[*.{jar,jks,keystore,png,ico}]
insert_final_newline = false
